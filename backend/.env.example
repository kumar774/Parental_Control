# ==============================================================================
# Parental Control Platform - Backend Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Database Connection (PostgreSQL 16+)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://parental_admin:REPLACE_WITH_SECURE_PASSWORD@127.0.0.1:5432/parental_control_admin_db

# Cache & Message Broker (Redis 7+)
REDIS_URL=redis://127.0.0.1:6379

# Cryptographic Keys (Mandatory 64-char hexadecimal string in production: openssl rand -hex 32)
# Production strictly fails to start if these use known development defaults.
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IDENTIFIER_RATE_LIMIT_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 Storage (Optional in development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# NOTE: Superadmin credentials are NOT configured here.
# Initial Superadmin is provisioned via the secure CLI command:
#   npx tsx backend/bin/admin-cli.ts provision
# (Supports temporary bootstrap env: BOOTSTRAP_SUPERADMIN_EMAIL, BOOTSTRAP_SUPERADMIN_USERNAME, BOOTSTRAP_SUPERADMIN_PASSWORD)

# ==============================================================================
# SMTP Email Delivery (Optional in dev — defaults to Mailpit local sink)
# Local development with Mailpit:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_SECURE=false
#   SMTP_FROM=security@parentalcontrol.local
#   SMTP_FROM_NAME=Parental Control Security
#   Mailpit Web UI: http://localhost:8025
# Production settings can also be securely configured via the Admin Panel Settings UI.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=

