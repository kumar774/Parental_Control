{
  "name": "parental-control-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production Backend & Control Plane for Enterprise Parental Control System",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/index.js",
    "test": "tsx --test tests/unit/**/*.test.ts tests/integration/*.test.ts",
    "test:real-pg": "tsx --test --test-concurrency=1 tests/integration/real-postgres/**/*.test.ts",
    "test:all": "tsx --test tests/**/*.test.ts",
    "test:load": "tsx --test tests/unit/phase9-load-benchmark.test.ts",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/websocket": "^11.3.7",
    "argon2": "^0.41.1",
    "bullmq": "^6.7.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "ws": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.30.4",
    "exceljs": "^4.4.0",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
